@page "/my-items"
@using U_Borrow_It.Core.DTOs
@using U_Borrow_It.Core.Interfaces
@inject ILentItemRepository Repo
@using U_Borrow_It.Components.Dialogs
@inject DialogService DialogService
@using System.Security.Claims
@inject IAccountRepository AccountRepo

<PageTitle>My Items</PageTitle>

<h3>My Items</h3>

@if (loading)
{
    <p>Loading…</p>
}
else if (!accountLinked)
{
    <p>Your login isn't linked to an account yet, so there are no items to show. Please contact an administrator.</p>
}
else
{
    <div class="mb-3 d-flex gap-2">
        <input class="form-control"
            placeholder="Search items by name..."
            @bind="searchText" />

        <button class="btn btn-primary" @onclick="SearchItems">
            Search
        </button>

        <button class="btn btn-secondary" @onclick="ClearSearch">
            Clear
        </button>
    </div>

    <div>
        <input @bind="newTitle" placeholder="Title" maxlength="100" />
        <input @bind="newDescription" placeholder="Description (optional)" maxlength="2000" />
        <button @onclick="SaveItem">Save</button>
    </div>

    @if (errorMessage != "")
    {
        <p style="color: red;">@errorMessage</p>
    }

    @if (items.Count == 0)
    {
        <p>You haven't added any items yet.</p>
    }
    else
    {
        <ul>
            @foreach (var item in items)
            {
                <li>
                    <button class="btn btn-link p-0" @onclick="() => OpenDetails(item)">
                        @item.Title
                    </button>
                </li>
            }
        </ul>
    }
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    private Guid accountId;
    private bool accountLinked = false;
    private bool loading = true;

    private string newTitle = "";
    private string newDescription = "";
    private string errorMessage = "";
    private List<LentItem> items = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateTask;
        var userId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier);

        if (userId != null)
        {
            var foundId = await AccountRepo.GetAccountIdForUserAsync(userId);
            if (foundId != null)
            {
                accountId = foundId.Value;
                accountLinked = true;
                await LoadItems();
            }
        }

        loading = false;
    }

    private async Task SaveItem()
    {
        errorMessage = "";

        if (string.IsNullOrWhiteSpace(newTitle))
        {
            errorMessage = "Please enter a title.";
            return;
        }

        try
        {
            await Repo.AddAsync(accountId, newTitle.Trim(), newDescription.Trim());
            newTitle = "";
            newDescription = "";
            await LoadItems();
        }
        catch (Exception ex)
        {
            errorMessage = "Could not save item: " + ex.Message;
        }
    }

    private async Task LoadItems()
    {
        try
        {
            items = await Repo.GetForAccountAsync(accountId);
        }
        catch (Exception ex)
        {
            errorMessage = "Could not load items: " + ex.Message;
        }
    }

    private string searchText = "";

    private async Task SearchItems()
    {
        errorMessage = "";
        if (string.IsNullOrWhiteSpace(searchText))
        {
            await LoadItems();
            return;
        }
        try
        {
            items = await Repo.SearchForAccountAsync(
                accountId, searchText.Trim());
        }
        catch (Exception ex)
        {
            errorMessage = "Could not search items: " + ex.Message;
        }
    }

    private async Task ClearSearch()
    {
        searchText = "";
        errorMessage = "";
        await LoadItems();
    }

    private async Task OpenDetails(LentItem item)
    {
        var result = await DialogService.OpenAsync<ItemDetailsDialog>(
            item.Title,
            new Dictionary<string, object> { { "Item", item } },
            new DialogOptions
            {
                ShowClose = true,
                CloseDialogOnOverlayClick = true,
                Width = "Min(700px, calc(100vw - 4rem))"
            });

        if (result is ItemDetailsResult.Delete)
        {
            await DeleteItem(item);
        }
        else if (result is ItemDetailsResult.Edit)
        {
            await EditItem(item);
        }
    }

    private async Task DeleteItem(LentItem item)
    {
        errorMessage = "";

        try
        {
            bool deleted = await Repo.DeleteAsync(item.LentItemID, accountId);

            if (!deleted)
            {
                errorMessage = "That item couldn't be found. It may have already been deleted.";
            }

            await LoadItems();
        }
        catch (Exception ex)
        {
            errorMessage = "Could not delete item: " + ex.Message;
        }
    }

        private async Task EditItem(LentItem item)
    {
        var edited = await DialogService.OpenAsync<EditItemDialog>(
            "Edit item",
            new Dictionary<string, object> { { "Item", item } },
            new DialogOptions
            {
                ShowClose = false,
                CloseDialogOnOverlayClick = false,
                CloseDialogOnEsc = true,
                Width = "min(600px, calc(100vw - 4rem))"
            });

        if (edited is LentItem changes)
        {
            errorMessage = "";

            try
            {
                bool updated = await Repo.UpdateAsync(
                    item.LentItemID, accountId, changes.Title, changes.Description);

                if (!updated)
                {
                    errorMessage = "That item couldn't be found. It may have been deleted.";
                }

                await LoadItems();
            }
            catch (Exception ex)
            {
                errorMessage = "Could not update item: " + ex.Message;
                return;
            }
        }

        // Reopen the details popup, showing the latest version of the item
        var current = items.FirstOrDefault(i => i.LentItemID == item.LentItemID);
        if (current != null)
        {
            await OpenDetails(current);
        }
    }
}
